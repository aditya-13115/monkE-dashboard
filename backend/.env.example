# ============================================================
# Groq
# ============================================================

# Comma-separated Groq API keys.
# Do not put real keys in .env.example.
# Example:
# GROQ_API_KEYS=gsk_key1,gsk_key2,gsk_key3

GROQ_API_KEYS=your_groq_key_1,your_groq_key_2

# Model used for comment sentiment analysis
GROQ_SENTIMENT_MODEL=openai/gpt-oss-20b

# Maximum number of sentiment batches processed concurrently
GROQ_SENTIMENT_CONCURRENCY=2


# ============================================================
# Campaign / Excel
# ============================================================

# Legacy/default workbook path.
# Multibrand campaigns are managed through the campaign registry.
CAMPAIGN_XLSX_PATH=../data/ASIAN PAINTS (1).xlsx


# ============================================================
# Instagram / Playwright
# ============================================================

# true = background/headless browser
# false = show Chromium for debugging
INSTAGRAM_HEADLESS=true

# Maximum concurrent Instagram fetch workers
INSTAGRAM_FETCH_CONCURRENCY=10

# Maximum concurrent bulk-sync workers
INSTAGRAM_SYNC_CONCURRENCY=10

# Keep false to avoid multiple visible Chromium windows
INSTAGRAM_ALLOW_VISIBLE_PARALLEL=false

# Retry failed empty-comment extraction after this many seconds
INSTAGRAM_EMPTY_COMMENT_RETRY_SECONDS=60

# Number of browser recovery attempts after a Chromium/page crash
INSTAGRAM_BROWSER_RECOVERY_ATTEMPTS=2

# Persistent Instagram authentication/profile directory
INSTAGRAM_USER_DATA_DIR=data/instagram_profile


# ============================================================
# Admin / Read-only POC Viewer
# ============================================================

# Protect admin operations such as campaign upload/delete.
# Replace with a long random secret in your real .env.
MONKE_ADMIN_KEY=your_admin_secret

# Base URL used when generating shareable read-only POC links.
# Example:
# PUBLIC_VIEWER_BASE_URL=https://view.example.com
PUBLIC_VIEWER_BASE_URL=http://localhost:5173